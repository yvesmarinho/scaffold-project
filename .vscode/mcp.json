{
	"servers": {
		"memory": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-memory"
			],
			"type": "stdio"
		},
		"sequential-thinking": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-sequential-thinking"
			],
			"type": "stdio"
		},
		"obsidian-rest": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"--with",
				"mcp==1.1.0",
				"mcp-obsidian"
			],
			"env": {
				"OBSIDIAN_API_KEY": "${env:OBSIDIAN_API_KEY}",
				"OBSIDIAN_HOST": "${env:OBSIDIAN_HOST}",
				"OBSIDIAN_PROTOCOL": "https",
				"OBSIDIAN_PORT": "27124"
			}
		},
		"filesystem": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"${workspaceFolder}"
			],
			"type": "stdio"
		},
		"io.github.github/github-mcp-server": {
			"type": "stdio",
			"command": "docker",
			"args": [
				"run",
				"-i",
				"--rm",
				"-e",
				"GITHUB_PERSONAL_ACCESS_TOKEN=${input:github-token}",
				"ghcr.io/github/github-mcp-server:1.4.0"
			]
		}
	},
	"inputs": [
		{
			"id": "github-token",
			"type": "promptString",
			"description": "GitHub Personal Access Token (PAT) com permissões: repo, read:org, read:user",
			"password": true
		}
	]
}
